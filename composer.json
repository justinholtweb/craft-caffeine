{
    "name": "justinholtweb/craft-caffeine",
    "description": "Instant faceted search and filtering for Craft — model an index in the control panel, and Caffeine keeps a self-contained JSON search artifact up to date and served, so refinements resolve in milliseconds without an element query.",
    "type": "craft-plugin",
    "version": "6.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "caffeine",
        "search",
        "faceted search",
        "facets",
        "filtering",
        "instantsearch",
        "algolia",
        "htmx",
        "sprig"
    ],
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "issues": "https://github.com/justinholtweb/craft-caffeine/issues",
        "source": "https://github.com/justinholtweb/craft-caffeine"
    },
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\Caffeine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\Caffeine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "conformance": [
            "@php vendor/bin/pest --group=conformance",
            "node tests/Conformance/run.mjs"
        ],
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "scripts-descriptions": {
        "conformance": "Runs the shared fixture suite against both query engines. The PHP pass compiles the artifacts the JavaScript pass consumes, so the order matters."
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "name": "Caffeine",
        "handle": "caffeine",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-caffeine/blob/6.0.0/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-caffeine/6.0.0/CHANGELOG.md",
        "class": "JustinHoltWeb\\Caffeine\\Plugin"
    }
}
