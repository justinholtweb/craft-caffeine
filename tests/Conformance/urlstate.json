{
  "name": "urlstate",
  "type": "urlstate",
  "path": "/products",
  "facets": {
    "brand": {
      "type": "string",
      "values": [
        "Acme",
        "Globex",
        "Smith, John",
        "Back\\slash",
        "Ünïcode",
        "Two Words"
      ]
    },
    "category": {
      "type": "hierarchical",
      "values": [
        "Home",
        "Home > Tools"
      ]
    },
    "price": {
      "type": "numeric",
      "values": [
        10,
        50,
        19.99
      ]
    },
    "featured": {
      "type": "boolean",
      "values": [
        true,
        false
      ]
    },
    "postDate": {
      "type": "date",
      "values": [
        1775403180,
        1781197320
      ]
    }
  },
