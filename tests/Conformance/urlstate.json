    {
      "name": "everything at once",
      "state": {
        "query": "saw",
        "refinements": {
          "brand": [
            "Acme"
          ],
          "featured": [
            false
          ]
        },
        "ranges": {
          "price": {
            "min": 10,
            "max": 50
          }
        },
        "sortBy": "price_asc",
        "page": 2,
        "hitsPerPage": 12
      },
      "expectParams": {
        "q": "saw",
        "brand": "Acme",
        "featured": "false",
        "price": "10..50",
        "sort": "price_asc",
        "page": "3",
        "perPage": "12"
      },
      "expectUrl": "/products?q=saw&brand=Acme&featured=false&price=10..50&sort=price_asc&page=3&perPage=12",
      "expectParsed": {
        "query": "saw",
        "refinements": {
          "brand": [
            "Acme"
          ],
          "featured": [
            false
          ]
        },
        "ranges": {
          "price": {
            "min": 10,
            "max": 50
          }
        },
        "sortBy": "price_asc",
        "page": 2,
        "hitsPerPage": 12
      }
    },
