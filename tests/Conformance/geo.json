{
  "name": "geo",
  "index": {
    "handle": "shops",
    "name": "Shops",
    "hitsPerPage": 24,
    "attributes": [
      {
        "key": "title",
        "source": "attribute",
        "path": "title",
        "roles": ["searchable", "sortable", "payload"],
        "searchWeight": 5
      },
      {
        "key": "near",
        "label": "Near",
        "source": "field",
        "path": "address",
        "roles": ["facet"],
        "facetType": "geo"
      },
      {
        "key": "kind",
        "source": "field",
        "path": "kind",
        "roles": ["facet"],
        "facetType": "string",
        "facetOperator": "or"
      }
    ]
  },
  "records": [
    {
      "objectId": "1-1",
      "searchable": { "title": "Charlotte" },
      "sortable": { "title": "Charlotte" },
      "payload": { "title": "Charlotte" },
      "facets": { "kind": ["store"] },
      "geo": { "near": [35.2271, -80.8431] }
    },
    {
      "objectId": "2-1",
      "searchable": { "title": "Asheville" },
      "sortable": { "title": "Asheville" },
      "payload": { "title": "Asheville" },
      "facets": { "kind": ["store"] },
      "geo": { "near": [35.5951, -82.5515] }
    },
    {
      "objectId": "3-1",
      "searchable": { "title": "Raleigh" },
      "sortable": { "title": "Raleigh" },
      "payload": { "title": "Raleigh" },
      "facets": { "kind": ["depot"] },
      "geo": { "near": [35.7796, -78.6382] }
    },
    {
      "objectId": "4-1",
      "searchable": { "title": "Atlanta" },
      "sortable": { "title": "Atlanta" },
      "payload": { "title": "Atlanta" },
      "facets": { "kind": ["store"] },
      "geo": { "near": [33.749, -84.388] }
    },
    {
      "objectId": "5-1",
      "searchable": { "title": "Online only" },
      "sortable": { "title": "Online only" },
      "payload": { "title": "Online only" },
      "facets": { "kind": ["store"] }
    }
  ],
  "cases": [
    {
      "name": "no geo refinement leaves everything in, coordinates or not",
      "state": {},
      "expect": { "nbHits": 5 }
    },
    {
      "name": "a tight radius keeps only what is inside it",
      "state": { "around": { "near": { "lat": 35.2271, "lng": -80.8431, "radius": 1000 } } },
      "expect": { "nbHits": 1, "hits": ["1-1"] }
    },
    {
      "name": "a wider radius reaches the next town",
      "state": { "around": { "near": { "lat": 35.2271, "lng": -80.8431, "radius": 200000 } } },
      "expect": { "nbHits": 2, "hits": ["1-1", "2-1"] }
    },
    {
      "name": "the boundary is inclusive to the metre",
      "state": { "around": { "near": { "lat": 35.2271, "lng": -80.8431, "radius": 160139 } } },
      "expect": { "nbHits": 2, "hits": ["1-1", "2-1"] }
    },
    {
      "name": "one metre short of the boundary excludes it",
      "state": { "around": { "near": { "lat": 35.2271, "lng": -80.8431, "radius": 160138 } } },
      "expect": { "nbHits": 1, "hits": ["1-1"] }
    },
    {
      "name": "a record with no coordinates is never within any radius",
      "state": { "around": { "near": { "lat": 35.2271, "lng": -80.8431, "radius": 20000000 } } },
      "expect": { "nbHits": 4 }
    },
    {
      "name": "a radius of zero filters nothing and only enables the distance sorting",
      "state": { "around": { "near": { "lat": 35.2271, "lng": -80.8431, "radius": 0 } }, "sortBy": "distance" },
      "expect": { "nbHits": 5, "hits": ["1-1", "2-1", "3-1", "4-1", "5-1"] }
    },
    {
      "name": "distance sorting orders by nearest, with the uncoordinated last",
      "state": { "around": { "near": { "lat": 35.7796, "lng": -78.6382, "radius": 0 } }, "sortBy": "distance" },
      "expect": { "nbHits": 5, "hits": ["3-1", "1-1", "2-1", "4-1", "5-1"] }
    },
    {
      "name": "a geo filter composes with an ordinary facet",
      "state": {
        "around": { "near": { "lat": 35.2271, "lng": -80.8431, "radius": 400000 } },
        "refinements": { "kind": ["depot"] }
      },
      "expect": { "nbHits": 1, "hits": ["3-1"] }
    },
    {
      "name": "facet counts respect the radius",
      "state": {
        "around": { "near": { "lat": 35.2271, "lng": -80.8431, "radius": 200000 } },
        "facets": ["kind"]
      },
      "expect": { "nbHits": 2, "facets": { "kind": [["store", 2]] } }
    }
  ]
}
