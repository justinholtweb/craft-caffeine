{
  "name": "stopwords",
  "index": {
    "handle": "library",
    "name": "Library",
    "hitsPerPage": 24,
    "stopwords": ["the", "of", "a"],
    "synonyms": ["sofa, couch, settee", "car, automobile"],
    "attributes": [
      {
        "key": "title",
        "source": "attribute",
        "path": "title",
        "roles": ["searchable", "sortable", "payload"],
        "searchWeight": 5
      },
      {
        "key": "shelf",
        "source": "field",
        "path": "shelf",
        "roles": ["facet"],
        "facetType": "string",
        "facetOperator": "or"
      }
    ]
  },
  "records": [
    {
      "objectId": "1-1",
      "searchable": { "title": "The Art of Sofa Making" },
      "sortable": { "title": "The Art of Sofa Making" },
      "payload": { "title": "The Art of Sofa Making" },
      "facets": { "shelf": ["craft"] }
    },
    {
      "objectId": "2-1",
      "searchable": { "title": "Car Maintenance" },
      "sortable": { "title": "Car Maintenance" },
      "payload": { "title": "Car Maintenance" },
      "facets": { "shelf": ["practical"] }
    },
    {
      "objectId": "3-1",
      "searchable": { "title": "The Saw Handbook" },
      "sortable": { "title": "The Saw Handbook" },
      "payload": { "title": "The Saw Handbook" },
      "facets": { "shelf": ["craft"] }
    }
  ],
  "cases": [
    {
      "name": "a query that is entirely stopwords matches everything, not nothing",
      "state": { "query": "the" },
      "expect": { "nbHits": 3, "hits": ["1-1", "2-1", "3-1"] }
    },
    {
      "name": "several stopwords together are still no query at all",
      "state": { "query": "the of a" },
      "expect": { "nbHits": 3 }
    },
    {
      "name": "a stopword beside a real word is ignored rather than failing the match",
      "state": { "query": "the saw" },
      "expect": { "nbHits": 1, "hits": ["3-1"] }
    },
    {
      "name": "a stopword is not indexed either",
      "state": { "query": "art" },
      "expect": { "nbHits": 1, "hits": ["1-1"] }
    },
    {
      "name": "a synonym finds the word that was actually written",
      "state": { "query": "couch" },
      "expect": { "nbHits": 1, "hits": ["1-1"] }
    },
    {
      "name": "every word in a synonym group is interchangeable",
      "state": { "query": "settee" },
      "expect": { "nbHits": 1, "hits": ["1-1"] }
    },
    {
      "name": "the original word still matches",
      "state": { "query": "sofa" },
      "expect": { "nbHits": 1, "hits": ["1-1"] }
    },
    {
      "name": "a second synonym group is independent of the first",
      "state": { "query": "automobile" },
      "expect": { "nbHits": 1, "hits": ["2-1"] }
    },
    {
      "name": "a synonym does not leak into unrelated records",
      "state": { "query": "couch", "facets": ["shelf"] },
      "expect": { "nbHits": 1, "facets": { "shelf": [["craft", 1]] } }
    }
  ]
}
